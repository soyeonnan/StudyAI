# 백엔드 환경변수 예시. 실제 값은 .env 파일에 넣고 절대 커밋하지 않는다.

# JWT 서명용 비밀키 (필수). 아래 명령으로 생성 가능:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# 토큰 만료 시간(분). 기본 1440(1일)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DB 연결. 개발: SQLite / 운영: PostgreSQL 예시 아래
DATABASE_URL=sqlite:///./study_calendar.db
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/study_calendar

# CORS 허용 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173
