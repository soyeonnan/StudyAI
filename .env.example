# docker-compose용 환경변수 예시.
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 절대 커밋하지 않는다.

# JWT 서명용 비밀키 (필수). 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# 토큰 만료(분). 기본 1440(1일)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL 접속 정보
POSTGRES_USER=study
POSTGRES_PASSWORD=
POSTGRES_DB=study_calendar

# 프론트 공개 포트 (호스트)
FRONTEND_PORT=8080

# CORS 허용 오리진 (프론트 주소)
CORS_ORIGINS=http://localhost:8080

# --- 모니터링 스택 (선택) ---
# Grafana 관리자 계정. 비밀번호는 반드시 지정한다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
